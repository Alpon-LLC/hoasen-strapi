{
  "kind": "collectionType",
  "collectionName": "team_members",
  "info": {
    "singularName": "team-member",
    "pluralName": "team-members",
    "displayName": "TeamMember"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "role": {
      "type": "string",
      "required": true
    },
    "social_links": {
      "type": "component",
      "component": "pages.team-social-link",
      "repeatable": true
    },
    "framework_and_tool": {
      "type": "component",
      "component": "pages.team-framework-and-tool",
      "repeatable": true
    },
    "experience": {
      "type": "component",
      "component": "pages.team-experience",
      "repeatable": true
    },
    "skills": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::skill.skill",
      "mappedBy": "team_members"
    },
    "get_to_know": {
      "type": "text"
    },
    "why_work_with_them": {
      "type": "text"
    }
  }
}
